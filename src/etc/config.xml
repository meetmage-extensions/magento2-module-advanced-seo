<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <meetmage_advancedseo>
            <general>
                <enabled>1</enabled>
            </general>
            <meta>
                <title_max_length>60</title_max_length>
                <description_max_length>160</description_max_length>
            </meta>
            <structured_data>
                <organization>1</organization>
                <website>1</website>
                <product>1</product>
                <brand_attribute>manufacturer</brand_attribute>
                <breadcrumbs>1</breadcrumbs>
            </structured_data>
            <canonical>
                <cms_pages>1</cms_pages>
                <configurable_parent>0</configurable_parent>
            </canonical>
        </meetmage_advancedseo>
    </default>
</config>
